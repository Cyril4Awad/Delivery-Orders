<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings, copied to the publish folder (the SDK fills in the aspNetCore line).
  WebDAV is removed: where it is installed, IIS answers PUT and DELETE itself with 405, so changing an
  order's status from the table or marking a call handled fails while saving an order (POST) works.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Main.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
